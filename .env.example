# AI GUI generation (P0). Copy to .env.local for local runs; set the same
# vars in your deployment provider for production. Never commit real secrets.

# Provider selection: "glm" (default when GLM_API_KEY is set), "mock"
# (deterministic keyword classifier — dev/e2e only), or "disabled".
AI_PROVIDER=

# GLM / Zhipu OpenAI-compatible endpoint credentials.
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Abuse guards (per server instance). Defaults shown.
AI_RATE_HOUR=8        # generations per IP per hour
AI_RATE_DAY=25        # generations per IP per day
AI_DAILY_BUDGET=1500  # total generations per instance per day (0 = unlimited)
AI_TIMEOUT_MS=20000   # provider call timeout
