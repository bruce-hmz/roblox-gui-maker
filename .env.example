# AI GUI generation (P0). Copy to .env.local for local runs; set the same
# vars in your deployment provider for production. Never commit real secrets.

# Provider selection: "glm" (default when GLM_API_KEY is set), "mock"
# (deterministic keyword classifier — dev/e2e only), or "disabled".
AI_PROVIDER=

# GLM / Zhipu OpenAI-compatible endpoint credentials.
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Abuse guards (per server instance). Defaults shown.
AI_RATE_HOUR=8        # generations per IP per hour
AI_RATE_DAY=25        # generations per IP per day
AI_DAILY_BUDGET=1500  # total generations per instance per day (0 = unlimited)
AI_TIMEOUT_MS=20000   # provider call timeout

# PVUV.ai analytics & crawler sync (optional).
# Public site ID inlined at build time for the browser SDK (www.pvuv.ai/f.js).
NEXT_PUBLIC_PVUV_SITE=
# Public site ID for Cloudflare Worker crawler sync (set via wrangler.jsonc vars in production).
PVUV_SITE=
# Server-side ingest-only token for Worker crawler sync — set via `wrangler secret put PVUV_INGEST_TOKEN`, never commit or expose to the client.
PVUV_INGEST_TOKEN=

# Waffo Pancake checkout (https://api.waffo.ai) & Pro Pass signing.
# Set the same vars via `wrangler secret put` on the `roblox-gui-maker` Worker.
PRO_PASS_SECRET=
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
# Single shared one-time product ID (uses dynamic priceSnapshot USD 9.90 / 19.90),
# or omit and set both per-plan product IDs below instead.
WAFFO_PRODUCT_ID=
WAFFO_PRODUCT_ID_STARTER=
WAFFO_PRODUCT_ID_ALL_ACCESS=
# "prod" (default) or "test"
WAFFO_ENVIRONMENT=prod
