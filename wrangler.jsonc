// Cloudflare Workers config — deployed via @opennextjs/cloudflare
// (`npm run deploy`). Domain: robloxguimaker.app (zone already on Cloudflare).
// Server-side PVUV_INGEST_TOKEN is stored separately via
// `wrangler secret put PVUV_INGEST_TOKEN`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roblox-gui-maker",
  "main": "./worker-wrapper.js",
  // Custom domains only (robloxguimaker.app + www); keep *.workers.dev off
  // to avoid duplicate-content indexing.
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PVUV_SITE": "3QGneU7d"
  }
  // Intentionally no `routes` / `custom_domain` here: after GFS cutover
  // (2026-11-23), apex + www custom domains belong to `gefeisites`, while
  // interactive routes (/api/*, /_next/*, /editor*, tools, etc.) are managed
  // separately via Cloudflare Zone Worker Routes (`scripts/setup-gfs-routes.mjs`).
}
